# Vault CLI environment for local operation against the self-managed cluster.
# Copy to .env (gitignored) and fill in. Taskfile loads .env automatically.
#
# This replaces the generated .env that `task bootstrap:apply` used to produce
# from HCP Vault cluster outputs. There is no bootstrap step any more: the
# cluster already exists and is managed outside this repository.

export VAULT_ADDR=''
export VAULT_TOKEN=''
export VAULT_NAMESPACE='admin'
